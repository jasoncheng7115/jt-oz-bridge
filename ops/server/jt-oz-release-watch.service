[Unit]
Description=Tell the Zulip channel when Zulip or OpenCode has a newer release
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/jt-oz-bridge/release-watch.py
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jt-oz-release-watch
StateDirectory=jt-oz-release-watch
