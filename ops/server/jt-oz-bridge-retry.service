[Unit]
Description=Start jt-oz-bridge again once it has been given up on for five minutes
ConditionPathExists=!/etc/jt-oz-bridge/promotion-active

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /opt/jt-oz-bridge/bridge-retry.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
